        "#Question 2\n",
        "#p1)\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "df = pd.read_csv('land_mines.csv')\n",
        "\n",
        "print(df.shape)\n",
        "print(df.head())\n",
        "print(df.dtypes)\n",
        "print(df.isna().sum())\n",
        "\n",
        "# how many of each mine type we have\n",
        "print(df['mine_type'].value_counts().sort_index())\n",
        "print(df['mine_type'].value_counts(normalize=True).sort_index().round(3))\n",
        "\n",
        "df['mine_type'].value_counts().sort_index().plot(kind='bar')\n",
        "plt.title('Count of each mine type')\n",
        "plt.xlabel('Mine type')\n",
        "plt.ylabel('Countt')\n",
        "plt.show()\n",
        "\n",
        "# basic stats for the features\n",
        "print(df[['voltage', 'height', 'soil']].describe())\n",
        "\n",
        "# how many different values each feature takes\n",
        "print(df[['voltage', 'height', 'soil']].nunique())\n",
        "print(df['soil'].value_counts().sort_index())\n",
        "\n",
        "df[['voltage', 'height', 'soil']].hist(bins=20, figsize=(12, 4), layout=(1, 3))\n",
        "plt.suptitle('Distributions of feature')\n",
        "plt.show()\n",
        "\n",
        "# avg feature values for each mine type\n",
        "print(df.groupby('mine_type')[['voltage', 'height', 'soil']].mean().round(3))\n",
        "\n",
        "# checking if any feature separates the mine types\n",
        "fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
        "for ax, col in zip(axes, ['voltage', 'height', 'soil']):\n",
        "    sns.boxplot(data=df, x='mine_type', y=col, ax=ax)\n",
        "    ax.set_title(f'{col} by Mine Type')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "sns.scatterplot(data=df, x='voltage', y='height', hue='mine_type', palette='tab10')\n",
        "plt.title('Voltage vs. height by Type')\n",
        "plt.show()\n",
        "\n",
        "\n",
        "\n",
        "#PART 2\n",
        "\n",
        "\n",
        "\n",
        "# do the features move together at all\n",
        "print(df[['voltage', 'height', 'soil']].corr().round(3))\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "X = df[['voltage', 'height', 'soil']]\n",
        "y = df['mine_type']\n",
        "\n",
        "# stratify keeps the same mix of mine types in both halves\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, test_size=0.5, random_state=42, stratify=y\n",
        ")\n",
        "\n",
        "print(X_train.shape, X_test.shape)\n",
        "print(y_train.value_counts().sort_index())\n",
        "print(y_test.value_counts().sort_index())\n",
        "\n",
        "#PART 3\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "\n",
        "# try k from 1 to 50 and see how each one does on the test set\n",
        "k_values = range(1, 51)\n",
        "train_acc = []\n",
        "test_acc = []\n",
        "\n",
        "for k in k_values:\n",
        "    model = KNeighborsClassifier(n_neighbors=k)\n",
        "    model.fit(X_train, y_train)\n",
        "    train_acc.append(model.score(X_train, y_train))\n",
        "    test_acc.append(model.score(X_test, y_test))\n",
        "\n",
        "best_k = k_values[np.argmax(test_acc)]\n",
        "print('best k:', best_k)\n",
        "print('test accuracy:', round(max(test_acc), 3))\n",
        "\n",
        "plt.plot(k_values, train_acc, label='Train')\n",
        "plt.plot(k_values, test_acc, label='Test')\n",
        "plt.axvline(best_k, color='gray', linestyle='--')\n",
        "plt.title('Accuracy vs. k')\n",
        "plt.xlabel('k')\n",
        "plt.ylabel('Accuracy')\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# final model with the best k\n",
        "knn = KNeighborsClassifier(n_neighbors=best_k)\n",
        "knn.fit(X_train, y_train)\n",
        "\n",
        "#I tried every k from 1 to 50, trained a model for each one on the training data, and checked its accuracy on the test data. I picked the k with the highest test accuracy, which was k= 2\n",
        "\n",
        "#PART 4\n",
        "\n",
        "y_pred = knn.predict(X_test)\n",
        "\n",
        "# rows are actual, columns are predicted\n",
        "print(pd.crosstab(y_test, y_pred, rownames=['Actual'], colnames=['Predicted']))\n",
        "\n",
        "print('accuracy:', round((y_pred == y_test).mean(), 3))\n",
        "\n",
        "# same table as percentages of each actual class\n",
        "print(pd.crosstab(y_test, y_pred, rownames=['Actual'], colnames=['Predicted'], normalize='index').round(2))\n",
        "'''\n",
        "The model is about 44% accurate on the test set.\n",
        "It does best on type 2 (anti-tank), getting 91% right, and is decent on type 1 (no mine) at 69%.\n",
        "It does poorly on types 3, 4, and 5 (anti-personnel), which it often confuses with each other or with type 1, and it never correctly predicts type 5.\n",
        "'''\n"
      ]
